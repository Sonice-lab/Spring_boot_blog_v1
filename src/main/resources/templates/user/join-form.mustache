{{> layout/header}}

<style>
    /* 회원가입/로그인 카드 테마 (공통 톤앤매너) */
    .card-custom {
        border: 1px solid #E6E6FA; /* 라벤더 테두리 */
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
        overflow: hidden;
    }

    /* 카드 헤더 커스텀 */
    .card-header-custom {
        background-color: #E6E6FA;
        color: #5D437A; /* 짙은 보라색 텍스트 */
        border-bottom: none;
        font-size: 1.3rem;
        padding: 1.2rem 1.5rem;
        text-align: center; /* 폼 형태는 타이틀을 중앙 정렬하는 것이 깔끔합니다 */
    }

    /* 입력창 커스텀 */
    .form-control-custom {
        border: 1px solid #E6E6FA;
        border-radius: 8px;
        color: #554A63;
        padding: 12px;
        font-size: 1.05rem;
    }

    .form-control-custom:focus {
        border-color: #B5EAD7; /* 포커스 시 라이트그린 테두리 */
        box-shadow: 0 0 0 0.25rem rgba(181, 234, 215, 0.4);
    }

    .form-control-custom::placeholder {
        color: #B0A8B9;
    }

    /* 파일 선택 버튼 커스텀 (라벤더 톤앤매너 적용) */
    .form-control-custom[type="file"]::file-selector-button {
        background-color: #E6E6FA;
        color: #5D437A;
        border: none;
        border-radius: 6px;
        padding: 6px 12px;
        margin: 0 9px 0 1px;
        font-weight: 600;
        transition: all 0.2s;
    }

    .form-control-custom[type="file"]:hover::file-selector-button {
        background-color: #D8D8F6;
    }

    /* 가입 버튼 커스텀 (라이트그린) */
    .btn-custom-submit {
        background-color: #B5EAD7;
        color: #1B402E;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        padding: 14px;
        font-size: 1.1rem;
        transition: all 0.3s;
    }

    .btn-custom-submit:hover {
        background-color: #9CD5C0;
        color: #1B402E;
    }
</style>

<div class="container p-5 d-flex justify-content-center align-items-center" style="min-height: 70vh;">
    <!-- 인증 폼은 가독성과 몰입감을 위해 너비를 500px 정도로 제한합니다 -->
    <div class="card card-custom w-100" style="max-width: 500px;">
        <div class="card-header card-header-custom">
            <i class="fa-solid fa-user-plus me-2"></i><b>회원가입</b>
        </div>
        <div class="card-body p-4 p-md-5">
            <!-- 파일을 보내려면 enctype을 반드시 multipart/form-data 이어야 함 -->
            <form action="/join" method="post" enctype="multipart/form-data">
                <div class="mb-4">
                    <label class="form-label fw-bold mb-2" style="color: #5D437A;">사용자명</label>
                    <input type="text" class="form-control form-control-custom" placeholder="사용자명을 입력해 주세요."
                           name="username">
                </div>
                <div class="mb-4">
                    <label class="form-label fw-bold mb-2" style="color: #5D437A;">비밀번호</label>
                    <input type="password" class="form-control form-control-custom" placeholder="비밀번호를 입력해 주세요."
                           name="password">
                </div>
                <div class="mb-4">
                    <label class="form-label fw-bold mb-2" style="color: #5D437A;">이메일</label>
                    <input type="email" class="form-control form-control-custom" placeholder="이메일을 입력해 주세요."
                           name="email">
                </div>
                <div class="mb-5">
                    <label for="profileImage" class="form-label fw-bold mb-2" style="color: #5D437A;">프로필 이미지 <span
                            class="fw-normal" style="font-size: 0.9rem; color: #8E829E;">(선택사항)</span></label>
                    <input type="file" class="form-control form-control-custom" id="profileImage" name="profileImage"
                           accept="image/**">
                    <small class="d-block mt-2" style="color: #8E829E;">JPG, PNG, GIF, WEBP 파일만 올릴 수 있습니다.(선택사항)</small>
                </div>
                <button type="submit" class="btn btn-custom-submit form-control">가입 완료하기</button>
            </form>
        </div>
    </div>
</div>

{{> layout/footer}}