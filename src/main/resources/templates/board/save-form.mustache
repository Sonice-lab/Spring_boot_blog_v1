{{> layout/header}}

<style>
    /* 폼 카드 테마 */
    .card-custom {
        border: 1px solid #E6E6FA; /* 라벤더 테두리 */
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
        overflow: hidden;
    }

    /* 카드 헤더 커스텀 */
    .card-header-custom {
        background-color: #E6E6FA; /* 라벤더 배경 */
        color: #5D437A; /* 짙은 보라색 텍스트 */
        border-bottom: none;
        padding: 1rem 1.5rem;
    }

    /* 입력창(Input, Textarea) 커스텀 */
    .form-control-custom {
        border: 1px solid #E6E6FA;
        border-radius: 8px;
        color: #554A63;
    }
    .form-control-custom:focus {
        border-color: #B5EAD7; /* 포커스 시 라이트그린 테두리 */
        box-shadow: 0 0 0 0.25rem rgba(181, 234, 215, 0.4);
    }
    .form-control-custom::placeholder {
        color: #B0A8B9;
    }

    /* 완료 버튼 커스텀 (라이트그린) */
    .btn-custom-submit {
        background-color: #B5EAD7;
        color: #1B402E;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s;
    }
    .btn-custom-submit:hover {
        background-color: #9CD5C0;
        color: #1B402E;
    }
</style>

<div class="container p-5">
    <div class="card card-custom">
        <div class="card-header card-header-custom"><b>글쓰기</b></div>
        <div class="card-body">
            {{! name 속성의 값이 서버에서 받을 때의 이름이 됩니다 }}
            <form action="/board/save" method="post">
                <div class="mb-3">
                    <input type="text" class="form-control form-control-custom" placeholder="제목" name="title">
                </div>
                <div class="mb-3">
                    <textarea class="form-control form-control-custom" rows="5" placeholder="내용" name="content"></textarea>
                </div>
                <button class="btn btn-custom-submit form-control">글쓰기 완료</button>
            </form>
        </div>
    </div>
</div>

{{> layout/footer}}