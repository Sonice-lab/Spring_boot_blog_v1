{{> layout/header}}

<style>
    /* 게시글 카드 테마 */
    .card-custom-list {
        border: 1px solid #E6E6FA; /* 라벤더 테두리 */
        border-radius: 12px;
        background-color: #ffffff;
        transition: all 0.3s ease-in-out;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
    }

    /* 카드 마우스 오버 효과 (살짝 위로 떠오르며 그림자 강조) */
    .card-custom-list:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(93, 67, 122, 0.08);
        border-color: #B5EAD7; /* 라이트그린으로 테두리 전환 */
    }

    /* 텍스트 색상 */
    .text-theme-primary {
        color: #5D437A; /* 짙은 보라색 */
        font-weight: 700;
    }
    .text-theme-secondary {
        color: #7A6F8B; /* 부드러운 보라빛 회색 */
        font-size: 0.95rem;
    }

    /* 상세보기 버튼 커스텀 (라이트그린) */
    .btn-custom-detail {
        background-color: #B5EAD7;
        color: #1B402E;
        border: none;
        border-radius: 8px;
        font-weight: 500;
        padding: 8px 24px;
        transition: all 0.3s;
    }
    .btn-custom-detail:hover {
        background-color: #9CD5C0;
        color: #1B402E;
    }

    /* 페이지네이션 커스텀 */
    .pagination-custom .page-link {
        color: #5D437A; /* 기본 글자색 (짙은 보라) */
        border-color: #E6E6FA; /* 테두리 (라벤더) */
        background-color: white;
        margin: 0 3px;
        border-radius: 6px;
        transition: all 0.3s;
    }
    .pagination-custom .page-link:hover {
        background-color: #E6E6FA; /* 호버 시 라벤더 배경 */
        color: #5D437A;
        border-color: #E6E6FA;
    }
    .pagination-custom .page-item.disabled .page-link {
        color: #B0A8B9;
        background-color: #FAFAFD;
        border-color: #E6E6FA;
    }
</style>

<div class="container p-5">
    {{#boardList}}
        <div class="card card-custom-list mb-4">
            <div class="card-body d-flex justify-content-between align-items-center p-4">
                <div>
                    <h4 class="card-title text-theme-primary mb-2">{{title}}</h4>
                    <p class="text-theme-secondary mb-0">
                        <i class="fa-solid fa-user me-1"></i> {{username}}
                        <span class="mx-2">|</span>
                        <i class="fa-regular fa-clock me-1"></i> {{createdAt}}
                    </p>
                </div>
                <div>
                    <a href="/board/{{id}}" class="btn btn-custom-detail">상세보기</a>
                </div>
            </div>
        </div>
    {{/boardList}}

    <!-- 페이지네이션 추후 구현 예정 -->
    <ul class="pagination pagination-custom d-flex justify-content-center mt-5">
        <li class="page-item disabled"><a class="page-link" href="#">Previous</a></li>
        <li class="page-item"><a class="page-link" href="#">1</a></li>
        <li class="page-item"><a class="page-link" href="#">2</a></li>
        <li class="page-item"><a class="page-link" href="#">Next</a></li>
    </ul>
</div>

{{> layout/footer}}