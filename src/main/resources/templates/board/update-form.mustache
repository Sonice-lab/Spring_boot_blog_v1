{{> layout/header}}

<style>
    /* 글 수정 카드 테마 (글쓰기 페이지와 동일한 톤앤매너 적용) */
    .card-custom {
        border: 1px solid #E6E6FA; /* 라벤더 테두리 */
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
        overflow: hidden;
    }

    /* 카드 헤더 커스텀 */
    .card-header-custom {
        background-color: #E6E6FA; /* 라벤더 배경 */
        color: #5D437A; /* 짙은 보라색 텍스트 */
        border-bottom: none;
        font-size: 1.25rem;
        padding: 1rem 1.5rem;
    }

    /* 입력창 커스텀 */
    .form-control-custom {
        border: 1px solid #E6E6FA;
        border-radius: 8px;
        color: #554A63;
        padding: 12px;
        font-size: 1.05rem;
    }
    .form-control-custom:focus {
        border-color: #B5EAD7; /* 포커스 시 라이트그린 테두리 */
        box-shadow: 0 0 0 0.25rem rgba(181, 234, 215, 0.4);
    }

    /* 수정 완료 버튼 커스텀 (라이트그린) */
    .btn-custom-submit {
        background-color: #B5EAD7;
        color: #1B402E;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        padding: 14px;
        font-size: 1.1rem;
        transition: all 0.3s;
    }
    .btn-custom-submit:hover {
        background-color: #9CD5C0;
        color: #1B402E;
    }
</style>

<div class="container p-5 d-flex justify-content-center">
    <!-- 글쓰기 창과 동일하게 max-width를 주어 안정감 있게 배치 -->
    <div class="card card-custom w-100" style="max-width: 900px;">
        <div class="card-header card-header-custom">
            <!-- 글쓰기(만년필) 대신 수정(펜과 노트) 아이콘 적용 -->
            <i class="fa-solid fa-pen-to-square me-2"></i><b>글 수정하기</b>
        </div>
        <div class="card-body p-4 p-md-5">
            <form action="/board/{{board.id}}/update" method="post">
                <div class="mb-4">
                    <input type="text" class="form-control form-control-custom" name="title" value="{{board.title}}">
                </div>
                <div class="mb-4">
                    <!-- 글쓰기 페이지와 동일하게 rows를 12 정도로 늘려 넉넉한 수정 공간 확보 -->
                    <textarea class="form-control form-control-custom" rows="12" name="content">{{board.content}}</textarea>
                </div>
                <button type="submit" class="btn btn-custom-submit form-control">수정 완료</button>
            </form>
        </div>
    </div>
</div>

{{> layout/footer}}