{{> layout/header}}

<style>
    /* 배경 및 레이아웃 정렬 */
    .error-page-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 70vh; /* 헤더/푸터 사이 중앙 정렬을 위한 넉넉한 높이 */
        padding: 2rem 1rem;
    }

    /* 에러 메시지 카드 스타일 (테마 공통 박스 디자인) */
    .error-card {
        background: #ffffff;
        border: 1px solid #E6E6FA; /* 라벤더 테두리 */
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03); /* 부드러운 그림자 */
        text-align: center;
        max-width: 550px;
        width: 100%;
        padding: 3.5rem 2rem;
    }

    /* 에러 제목 */
    .error-card h1 {
        font-size: 2.2rem;
        font-weight: 800;
        color: #5D437A; /* 짙은 보라색 */
        letter-spacing: -0.05rem;
    }

    /* 자물쇠 아이콘 커스텀 */
    .error-icon {
        font-size: 4.5rem;
        color: #B0A8B9; /* 튀지 않는 차분한 라벤더 그레이 톤으로 자물쇠 표현 */
        margin-bottom: 1.5rem;
    }

    /* 에러 상세 메시지 */
    .error-card .error-msg {
        font-size: 1.15rem;
        font-weight: 500;
        color: #554A63; /* 부드러운 보라빛 회색 */
        word-break: keep-all;
        line-height: 1.6;
    }

    /* 에러 서브 메시지 */
    .error-card .error-sub-msg {
        font-size: 0.95rem;
        color: #7A6F8B;
    }

    /* 버튼 공통 호버 애니메이션 */
    .error-btn-group .btn {
        transition: all 0.3s ease-in-out;
    }
    .error-btn-group .btn:hover {
        transform: translateY(-2px);
    }

    /* 서브 버튼 커스텀 (메인페이지 이동) */
    .btn-custom-back {
        background-color: #FAFAFD;
        color: #7A6F8B;
        border: 1px solid #E6E6FA;
        border-radius: 8px;
        font-weight: 600;
        padding: 12px 24px;
    }
    .btn-custom-back:hover {
        background-color: #E6E6FA;
        color: #5D437A;
    }

    /* 메인 액션 버튼 커스텀 (로그인 이동 - 라이트그린) */
    .btn-custom-main {
        background-color: #B5EAD7;
        color: #1B402E;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        padding: 12px 24px;
    }
    .btn-custom-main:hover {
        background-color: #9CD5C0;
        color: #1B402E;
    }
</style>

<!-- 메인 컨텐츠 영역 -->
<div class="error-page-wrapper">
    <div class="container d-flex justify-content-center">
        <div class="error-card">

            <!-- 시각적 효과를 위한 자물쇠 아이콘 (FontAwesome 사용으로 통일성 확보) -->
            <div class="error-icon">
                <i class="fa-solid fa-lock"></i>
            </div>

            <h1>Unauthorized 401</h1>

            <!-- 라벤더 색상의 구분선 -->
            <hr class="my-4" style="border-top: 2px solid #E6E6FA; opacity: 1;">

            <h3 class="error-msg mb-2">{{msg}}</h3>
            <p class="error-sub-msg mb-5">서비스를 이용하시려면 로그인이 필요합니다.</p>

            <!-- 이 페이지의 주 목적이 '로그인'이므로 라이트그린 버튼을 로그인에 배정 -->
            <div class="error-btn-group d-flex justify-content-center gap-3">
                <a href="/" class="btn btn-custom-back">메인페이지</a>
                <a href="/login" class="btn btn-custom-main">로그인</a>
            </div>

        </div>
    </div>
</div>

{{> layout/footer}}