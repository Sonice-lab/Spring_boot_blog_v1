<!-- 에러 메시지 부분 (기존 유지) -->
{{#errorMessage}}
    <div class="container p-3">
        <div class="alert alert-danger m-3">{{errorMessage}}</div>
    </div>
{{/errorMessage}}

<!-- 추가할 Footer 커스텀 CSS (헤더의 <style> 태그 안에 함께 넣으시면 됩니다) -->
<style>
    .footer-custom {
        background-color: #FAFAFD; /* 아주 옅은 라벤더/그레이 톤으로 헤더를 받쳐줌 */
        border-top: 3px solid #E6E6FA; /* 라벤더 색상으로 상단 경계선 포인트 */
        color: #554A63; /* 전체 텍스트 색상을 헤더와 맞춤 */
    }
    .footer-custom h4 {
        color: #5D437A; /* 짙은 보라색으로 타이틀 강조 */
        font-weight: 700;
        margin-bottom: 0.5rem;
    }
    .footer-custom h5 {
        color: #7A6F8B; /* 서브 텍스트는 살짝 더 부드러운 톤 */
        font-size: 1.1rem;
        margin-bottom: 1.5rem;
    }
    /* 라이트그린 톤앤매너에 맞춘 커스텀 버튼 */
    .btn-custom-outline {
        color: #2F694D; /* 짙은 초록색 텍스트 및 테두리 */
        border: 1px solid #2F694D;
        transition: all 0.3s ease-in-out;
        font-weight: 500;
        padding: 8px 20px;
        border-radius: 8px; /* 헤더 메뉴처럼 둥근 모서리 적용 */
    }
    .btn-custom-outline:hover {
        background-color: #B5EAD7; /* 마우스 오버 시 화사한 라이트그린 배경 */
        border-color: #B5EAD7;
        color: #1B402E; /* 텍스트는 더 어두운 톤으로 변경해 가독성 확보 */
    }
</style>

<!-- 디자인이 적용된 Footer -->
<footer class="footer-custom p-5 text-center mt-auto">
    <h4>Created by Tencoding</h4>
    <h5>Tel. 010-1234-1234</h5>
    <div class="mt-3">
        <button class="btn btn-custom-outline mx-1">고객센터</button>
        <button class="btn btn-custom-outline mx-1">오시는 길</button>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>